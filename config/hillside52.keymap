#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NUM  1

/* Home row mods (tap = key, hold = mod). The dedicated modifier keys on the
 * base layer are the PRIMARY way to use mods; these home-row holds are an
 * optional second way. Behavior is copied from the forager / sweep
 * "timeless" HRM setup (balanced flavor, large tapping-term, prior-idle,
 * cross-hand positional hold-tap resolved on release). */
#define HRML(k1,k2,k3,k4) &hml LSHIFT k1 &hml LCTRL k2 &hml LALT k3 &hml LGUI k4
#define HRMR(k1,k2,k3,k4) &hmr RGUI k1  &hmr RALT k2  &hmr RCTRL k3 &hmr RSHIFT k4

/* Positional hold-tap key positions, indexed into the matrix transform in
 * boards/shields/hillside52/hillside52.dtsi (0-based, in binding order). */
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 30 38 39 40   // left-hand keys
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 31 32 33 34 35 36 37 49 50 51 // right-hand keys
#define THUMBS 41 42 43 44 45 46 47 48                                       // thumb keys

/ {
        behaviors {
                // Thumb hold-tap (tap = TAB, hold = SHIFT). Timeless flavor,
                // no positional/idle guard so it works with either hand.
                ht: hold_tap {
                        label = "hold_tap";
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        bindings = <&kp>, <&kp>;
                };

                hml: home_row_mod_left {
                        label = "hrm_left";
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        hold-trigger-key-positions = <KEYS_R THUMBS>;
                        hold-trigger-on-release;
                        bindings = <&kp>, <&kp>;
                };

                hmr: home_row_mod_right {
                        label = "hrm_right";
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        hold-trigger-key-positions = <KEYS_L THUMBS>;
                        hold-trigger-on-release;
                        bindings = <&kp>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                base_layer {
/* BASE — QWERTY 60%-style. Dedicated mods (CTRL/GUI/ALT/SHIFT) are primary;
 *        home-row A S D F / J K L ; also act as mods when held. The inverted-T
 *        arrow cluster (Up over Left-Down-Right, bottom right) is hard-wired
 *        here and on NUM so it never moves or changes with mods/layers.
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |  `~  |   Q   |   W   |   E   |   R   |   T   |-----------------------------------|   Y   |   U   |   I   |   O   |   P   |   /   |
 * | TAB  |   A   |   S   |   D   |   F   |   G   |-----------------------------------|   H   |   J   |   K   |   L   | BSPC  |   \   |
 * | SHFT |   Z   |   X   |   C   |   V   |   B   |   '   |-------------------|   ;   |   N   |   M   |   ,   |   .   |  Up   | SHFT  |
 * | CTRL | GUI   | ALT   |-------|  ESC  | ENTER |SHFT/TB| ENTER |---|SPC/NUM| BSPC  |  ALT  |  GUI  |-------| Left  | Down  | Right |
 */
                        bindings = <
&kp  GRAVE    &kp  Q        &kp  W        &kp  E        &kp  R        &kp  T                                                                         &kp  Y        &kp  U        &kp  I        &kp  O        &kp  P        &kp  FSLH
&kp  TAB      HRML(A,           S,            D,            F)        &kp  G                                                                         &kp  H        HRMR(J,           K,            L,            BSPC)     &kp  BSLH
&kp  LSHFT    &kp  Z        &kp  X        &kp  C        &kp  V        &kp  B        &kp  SQT                                           &kp  SEMI     &kp  N        &kp  M        &kp  COMMA    &kp  DOT      &kp  UP       &kp  RSHFT
&kp  LCTRL    &kp  LGUI     &kp  LALT                   &kp  ESC      &kp  ENTER  &ht  LSHIFT TAB  &kp  ENTER          &lt  NUM SPACE  &kp  BSPC     &kp  RALT     &kp  RGUI                   &kp  LEFT     &kp  DOWN     &kp  RIGHT
                        >;
                };

                num_layer {
/* NUM — left-hand number pad (hold SPACE with the right thumb to reach it,
 *       then type numbers with the left hand; Shift + pad = symbols). Right
 *       hand holds brackets, Bluetooth and media. Same fixed arrow-T.
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |      |   7   |   8   |   9   |   -   |   =   |-----------------------------------|  BT0  |  BT1  |  BT2  |  BT3  |  BT4  |       |
 * |      |   4   |   5   |   6   |       |       |-----------------------------------| Prev  | Play  | Next  |   [   |   ]   |       |
 * |      |   1   |   2   |   3   |   0   |   .   |       |-------------------| BTCLR | Vol-  | Vol+  | Bri-  | Bri+  |  Up   |       |
 * |      |       |       |-------|       |       |       |       |---|       |       |       |       |-------| Left  | Down  | Right |
 */
                        bindings = <
&trans        &kp  N7       &kp  N8       &kp  N9       &kp  MINUS    &kp  EQUAL                                                                     &bt  BT_SEL 0 &bt  BT_SEL 1 &bt  BT_SEL 2 &bt  BT_SEL 3 &bt  BT_SEL 4 &trans
&trans        &kp  N4       &kp  N5       &kp  N6       &trans        &trans                                                                         &kp  C_PREV   &kp  C_PP     &kp  C_NEXT   &kp  LBKT     &kp  RBKT     &trans
&trans        &kp  N1       &kp  N2       &kp  N3       &kp  N0       &kp  DOT      &trans                                             &bt  BT_CLR   &kp  C_VOL_DN &kp  C_VOL_UP &kp  C_BRI_DN &kp  C_BRI_UP &kp  UP       &trans
&trans        &trans        &trans                      &trans        &trans        &trans        &trans                 &trans        &trans        &trans        &trans                      &kp  LEFT     &kp  DOWN     &kp  RIGHT
                        >;
                };
        };
};
