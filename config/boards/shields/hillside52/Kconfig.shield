config SHIELD_HILLSIDE52_LEFT
    def_bool $(shields_list_contains,hillside52_left)

config SHIELD_HILLSIDE52_RIGHT
    def_bool $(shields_list_contains,hillside52_right)

# Keyless central that owns the keymap when the keyboard runs through a USB
# dongle. See hillside52_dongle.overlay.
config SHIELD_HILLSIDE52_DONGLE
    def_bool $(shields_list_contains,hillside52_dongle)
